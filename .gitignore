# build output
dist/

# integration cache (esbuild config bundles, plugin-mode font subsets)
.shirones/

# Scratch directories the packaging pipeline creates when it transpiles the
# theme's TypeScript generators. They should never survive a run; the pattern
# is here so that an aborted one cannot reach a commit.
.shirones-ts-*/

# content repository working copy, provenance, and safe cleanup backups
.content-src/
.content-backup/
content.lock.json
Shirone-Content/

# materialized content: Obsidian vault metadata stays in the content repository
src/content/.obsidian/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

.vercel

package-lock.json
bun.lockb
yarn.lock

# ide
.idea

# generated font subsets
src/assets/fonts/.subset/

# generated local icon collection
src/generated/local-icon-collections.ts
# transient temp file from the icon collection writer (the overwrite rename can hit a file lock on Windows)
src/generated/*.tmp
*.iml

# anime snapshot data & downloaded covers
src/data/anime-snapshots/*.json
public/assets/anime/covers/*
!public/assets/anime/covers/.gitkeep

# generated responsive moment thumbnails
public/assets/moments/thumbnails/*
!public/assets/moments/thumbnails/.gitkeep

# local tooling artifacts
.zcode/
.codex-*.log
research/

# playwright
.playwright-cli/
test-results/
playwright-report/
tests/site/visual.spec.ts-snapshots/

# Lighthouse local reports
artifacts/lighthouse/*
!artifacts/lighthouse/.gitkeep
.lighthouseci/

# generated AI skills plugin packages
artifacts/shirone-ai-*

# content repository (materialized by `pnpm content:sync`)
# Only the mounts the external content repository actually provides are untracked;
# the full upstream list lives in scripts/content/eject.mjs.
/src/content/
/src/data/*.ts
/src/user/user-config.ts
/src/config/FooterConfig.html
/public/images/
