{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shirone Novel Page Config",
  "description": "小说界面配置（config/novel.yaml）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enable": {
      "type": "boolean",
      "description": "是否启用小说页；false 时导航入口隐藏并将 /novel/ 重定向到 404",
      "default": true
    },
    "title": {
      "type": "string",
      "description": "页面标题：字面量，或 \"$t:<i18nKey>\" 形式的本地化引用",
      "default": "$t:novel"
    },
    "description": {
      "type": "string",
      "description": "页面副标题：同上",
      "default": "$t:novelBanner"
    }
  }
}
