---
interface Props {
	class: string;
	/** 正文首行缩进两格（对应文章 frontmatter 的 `textIndent: true`） */
	textIndent?: boolean;
}
const className = Astro.props.class;
const textIndent = Astro.props.textIndent ?? false;
---
<div data-pagefind-body class={`prose dark:prose-invert prose-base !max-w-none custom-md markdown-content ${textIndent ? "custom-md--indent" : ""} ${className}`}>
	<slot />
</div>

<style lang="stylus" is:global>
@import "../../styles/markdown/generic.styl"
</style>

<script>
	import { bindMarkdownRuntime } from "@utils/markdown-runtime";

	bindMarkdownRuntime();
</script>
